NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/shop_inventory_ledger

# Frontend origin
FRONTEND_URL=http://localhost:5173

# Use a randomly generated secret of at least 32 characters
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d

# Initial Owner account (required when running the seed script)
OWNER_NAME=Shop Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ownerofnamelessshop@1234

# Initial Staff account (required when running the seed script)
STAFF_NAME=Shop Staff
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=staffofnamelessshop@1234
